{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "lib": ["ESNext", "DOM"],
    "types": ["vite/client"],
    "skipLibCheck": true,
    "esModuleInterop": true,
    "baseUrl": ".",
    "paths": {
      "@auipage/vue": [
        "src/index.ts"
      ]
    }
  },
  "include": [
    "src/**/*",
    "test/**/*",
    "types/**/*",
    "env.d.ts"
  ]
}
